APP_ENV=development
APP_URL=http://localhost:3000
# 公网部署默认应保持只读；仅在可信认证代理之后才允许公网写操作。
PUBLIC_DEMO_MODE=false
ALLOW_PUBLIC_MUTATIONS=false
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
SECRET_KEY=replace_with_a_random_32_byte_secret
ENCRYPTION_KEY=replace_with_a_different_random_32_byte_secret
POSTGRES_PASSWORD=replace_with_a_random_database_password
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/reddit_growth
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# 生产环境使用服务端托管的 DeepSeek；API Key 只能放在服务端环境变量中。
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_STRONG_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=150
LLM_ENABLE_THINKING=false
LLM_SETTINGS_LOCKED=true
LLM_DISPLAY_NAME="GrowthAgent AI"
LLM_INSTALLATION_ID=
# 公网 API 可选择为安装包提供受限模型网关；网关 Token 不是上游模型 Key。
MANAGED_LLM_GATEWAY_ENABLED=false
MANAGED_LLM_GATEWAY_TOKEN=
MANAGED_LLM_REQUESTS_PER_MINUTE=12
MANAGED_LLM_REQUESTS_PER_DAY=200
MANAGED_LLM_GLOBAL_REQUESTS_PER_DAY=10000
MANAGED_LLM_MAX_INPUT_CHARS=80000
MANAGED_LLM_MAX_OUTPUT_TOKENS=5000
GLOBAL_KILL_SWITCH=false
XIAOHONGSHU_MCP_IMAGE=xpzouying/xiaohongshu-mcp@sha256:88e2603f324f567e0a254ed7a1e24d632a16eccc30e84ef3fb887e34a03d0fe3
XIAOHONGSHU_MCP_URL=http://xiaohongshu-mcp:18060
XIAOHONGSHU_SEARCH_TIMEOUT_SECONDS=75
XIAOHONGSHU_AUTO_SCORE_THRESHOLD=0.75
XIAOHONGSHU_AUTO_RISK_THRESHOLD=0.35
XIAOHONGSHU_SEARCH_INTERVAL_HOURS=3
XIAOHONGSHU_MIN_PUBLISH_INTERVAL_HOURS=4
XIAOHONGSHU_KEYWORDS_PER_RUN=3
XIAOHONGSHU_DETAILS_PER_KEYWORD=2
