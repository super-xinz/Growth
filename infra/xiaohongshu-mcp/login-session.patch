+func (a *LoginAction) webSessionCookie() string {
+	cks, err := a.page.Browser().GetCookies()
+	if err != nil {
+		return ""
+	}
+
+	for _, ck := range cks {
+		if ck.Name == "web_session" {
+			return ck.Value
+		}
+	}
+
+	return ""
