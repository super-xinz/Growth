+func loginPageError(page *rod.Page) error {
+	info, err := page.Info()
+	if err != nil {
+		return nil
+	}
+
+	parsed, err := url.Parse(info.URL)
+	if err != nil || !strings.Contains(parsed.Path, "/website-login/error") {
+		return nil
+	}
+
+	message := parsed.Query().Get("error_msg")
+	if message == "" {
+		message = "login page rejected the request"
+	}
+	code := parsed.Query().Get("error_code")
+	if code == "" {
+		return errors.Errorf("xiaohongshu login page rejected request: %s", message)
+	}
+
+	return errors.Errorf("xiaohongshu login page rejected request: %s (code %s)", message, code)
+}
